{
  // Cloudflare Workers static-assets config for the draft assistant UI.
  //
  // WHY THIS FILE EXISTS. Cloudflare has merged Pages into Workers, so the
  // dashboard's "connect a repo" flow now creates a Worker and deploys it with
  // `npx wrangler deploy`. That command reads this file to learn what to serve.
  // Without it the deploy fails with no useful message.
  //
  // WHAT DEPLOYS. The app is a static Vite build -- no server, no API, no
  // secrets. `cd frontend && npm ci && npm run build` writes ./frontend/dist,
  // which includes the JSON exports copied in by the prebuild step
  // (frontend/scripts/sync-exports.mjs reads data/export/ at the repo root, so
  // the build must run from the repo root, not from frontend/).
  //
  // NO CREDENTIALS HERE, EVER. Cloudflare mints and holds its own deploy token;
  // nothing in this file is secret and nothing in this repo authenticates to
  // anything. See CLAUDE.md section 10.
  //
  // ACCESS. This publishes the founder's board -- his rankings, his
  // disagreements with consensus, his league. `worker/index.js` gates every
  // request behind HTTP Basic auth **when the SITE_PASSWORD secret is set**, and
  // leaves the site open when it is not, so deploying can never lock the founder
  // out before he has chosen a password. Basic auth rather than Cloudflare
  // Access: Access emails a code per login, which was both annoying and
  // unreliable in practice (2026-07-29) -- the mail did not arrive.
  //
  // WHY THERE IS NOW A WORKER SCRIPT. The assistant's reasoning lane
  // (`/__reasoning`) existed only as a Vite dev-server plugin, so on the hosted
  // site it was permanently dead. The Worker implements the same contract at the
  // edge, reading ANTHROPIC_API_KEY from Cloudflare's secret store. The key never
  // enters the browser bundle -- see frontend/vite.config.ts, which keeps it out
  // on purpose.
  //
  // SECRETS ARE NEVER IN THIS FILE. Set them with `npx wrangler secret put NAME`
  // or in the dashboard. CLAUDE.md section 10.
  "name": "fantasy-football",
  "compatibility_date": "2026-07-29",
  "main": "worker/index.js",
  "assets": {
    // `binding` is what makes env.ASSETS.fetch(request) available to the script.
    // Without it the Worker cannot serve the static build at all.
    "binding": "ASSETS",
    "directory": "./frontend/dist",
    // The app is a single-page build: unknown paths must return index.html so
    // client-side routing works instead of 404ing.
    "not_found_handling": "single-page-application"
  }
}

data/*.db
# data/raw/ is excluded EXCEPT founder-export/, which holds manual exports that
# exist nowhere else and that a from-scratch rebuild cannot reproduce (thread
# 080). Private repo, personal use -- consistent with D-020. Note the pattern
# must be `data/raw/*`, not `data/raw/`: git does not descend into an excluded
# directory, so a negation under `data/raw/` alone would never match.
data/raw/*
!data/raw/founder-export/
data/user pulled fantasy data/
.env
__pycache__/
*.pyc
.pytest_cache/
.claude/settings.local.json
*.bak-*
data/*.db-journal
data/*.db-wal
data/*.db-shm
.claude/worktrees/
# Yahoo OAuth token cache (src/providers/yahoo_oauth.py::TokenStore) -- the
# only Yahoo-derived data persisted anywhere in this project (ADR, thread
# FR-062). Not a raw league payload; access token + refresh token + expiry.
data/.yahoo_token.json

# ADR-070 sweep permutation-draw cache -- the LIVE csvs stay untracked (they
# are appended to continuously and would put a blob in history every commit).
# They are NOT merely regenerable: a full 8,999-draw cell costs 1-3 hours, and
# on 2026-08-04 a container disk rollback destroyed eight hours of them because
# this rule was read as "safe to lose". Durability now comes from a gzipped
# mirror in draws_archive/, which IS committed -- written by
# tools/sweep070_archive.py archive, and put back by ... restore, which the
# boot hook runs before relaunching the sweep.
experiments/bottomup/results/sweep070/draws/

# Local virtualenvs (a second one appeared 2026-08-04 and was untracked but
# not ignored, which is one careless `git add -A` away from a 300 MB commit).
.venv2/
